#!/usr/bin/env ruby
# frozen_string_literal: true

# Static audit for an Omarchy shell plugin.
#
# Emits a JSON report describing what the plugin can reach: its git provenance,
# its file inventory, and every rule hit with the reviewer's reasoning attached.
# The report is the input to the LLM pass (security/SKILL.md) as well as being
# useful on its own.
#
#   plugin-audit <plugin-dir> [--rules-dir DIR ...] [--pretty]
#
# Exit status is 0 whenever the scan itself completed: a finding is a result,
# not an error. Callers branch on summary.verdict.

require "fileutils"
require "json"
require "open3"
require "shellwords"

# The backend runs with LC_ALL=C, which would make File.read default to
# US-ASCII and raise on any UTF-8 plugin source. Force UTF-8 regardless of the
# caller's locale, and scrub invalid bytes so a malformed file degrades to a
# finding rather than a crash.
Encoding.default_external = Encoding::UTF_8
Encoding.default_internal = Encoding::UTF_8

SOURCE_ROOT = File.expand_path("..", __dir__)
DEFAULT_RULES = File.join(SOURCE_ROOT, "security", "omarchy-plugin.yar")

# Only text a plugin can actually execute or that steers execution. Binaries are
# reported as an inventory fact instead: yara on a .png is noise, but a shipped
# ELF in a QML plugin is itself the finding.
# Deliberately excludes .yar/.yara: rule files are data, never executed, and a
# ruleset scanned by its own rules matches every pattern it defines.
SCANNABLE = %w[.qml .js .sh .bash .rb .jq .py .pl .json .jsonc
               .desktop .service].freeze
COMMENT_PREFIXES = ["#", "//", "/*", "*", "--", "<!--", ";"].freeze
# Test code ships with the plugin but the shell never loads it. Across the
# marketplace it is named by file as often as by directory, and scanners in
# particular carry deliberately malicious fixtures.
TEST_PATH = %r{
  (\A|/)(tests?|spec|specs|fixtures?|__tests__|examples?|migrations)/ |
  (\A|/)(test|spec)[_-][^/]+\z |
  [._-](test|spec)\.[a-z]+\z
}x.freeze
# RFC1918, loopback and link-local are a plugin talking to the user's own
# network -- home server, local daemon, router. A public address is the
# finding. 169.254.169.254 is the cloud metadata endpoint and is its own thing.
PRIVATE_IP = %r{\A(127\.|10\.|192\.168\.|0\.0\.0\.0|255\.|169\.254\.|
                 172\.(1[6-9]|2[0-9]|3[01])\.)}x.freeze
METADATA_IP = "169.254.169.254"
# Public resolvers are connectivity checks, and RFC5737/RFC3849 ranges are
# documentation placeholders. Both showed up across the marketplace and
# neither is a callback worth waking anyone for.
BENIGN_IP = %w[8.8.8.8 8.8.4.4 1.1.1.1 1.0.0.1 9.9.9.9 208.67.222.222
               77.88.8.8 100.100.101.102 223.5.5.5].freeze
DOC_IP = %r{\A(192\.0\.2\.|198\.51\.100\.|203\.0\.113\.|224\.|239\.)}.freeze
DEMOTE = { "high" => "medium", "medium" => "low", "low" => "info",
           "info" => "info" }.freeze
BINARY_SUSPECT = %w[.so .bin .elf .out .appimage .pyc].freeze
OPAQUE_DATA = %w[.dat .bin .pack .blob .payload .tpl .cache].freeze
SEVERITY_ORDER = { "high" => 3, "medium" => 2, "low" => 1, "info" => 0 }.freeze

# Terse labels for compact UI. `why` remains the long explanation (tooltip /
# agent prompt); `short` is what a row shows so the panel stays scannable.
SHORT_LABELS = {
  "callback_fetch_pipe_shell" => "Downloads and runs remote code",
  "callback_download_and_execute" => "Downloads a file and executes it",
  "callback_download_to_disk" => "Downloads an executable to disk",
  "callback_outbound_http" => "Contacts the network",
  "callback_raw_ip_address" => "Talks to a hard-coded IP",
  "callback_dns_exfiltration" => "DNS lookup built from local data",
  "callback_raw_socket" => "Opens a raw socket",
  "obfuscation_encoded_execution" => "Decodes a blob and runs it",
  "obfuscation_dynamic_code" => "Builds code at runtime",
  "obfuscation_escaped_string_run" => "Hidden escaped-string payload",
  "obfuscation_reversed_command" => "Reversed / shuffled command",
  "credential_secret_paths" => "Reads private keys or secrets",
  "credential_cloud_provider" => "Reads cloud credentials (AWS/Azure/GCP)",
  "credential_steals_other_program_secrets" => "Reads another program's secrets",
  "credential_browser_profile" => "Reads a browser profile",
  "persistence_hidden_autostart" => "Hidden autostart / persistence",
  "persistence_systemd_unit" => "Installs a systemd unit",
  "persistence_shell_rcfile" => "Writes to your shell startup file",
  "persistence_writes_outside_plugin" => "Writes outside its own directory",
  "privilege_tampering" => "Tampers with root / sudoers",
  "capability_privilege_escalation" => "Runs a command as root",
  "combo_credential_exfil" => "Reads a secret and sends it out",
  "structure_runtime_qml_load" => "Loads QML from a decoded path",
  "structure_data_payload_exec" => "Runs a payload from a data file"
}.freeze

def short_label(rule)
  return SHORT_LABELS[rule] if SHORT_LABELS.key?(rule)
  return "Command-injection seam (#{rule.sub("injection_", "")})" if rule.start_with?("injection_")
  rule.sub(/\A[a-z]+_/, "").tr("_", " ").capitalize
end

def die(message)
  warn("plugin-audit: #{message}")
  exit 2
end

# --- arguments ---------------------------------------------------------------

plugin_dir = nil
rules_files = []
pretty = false
diff_ref = nil

args = ARGV.dup
until args.empty?
  arg = args.shift
  case arg
  when "--rules-dir"
    dir = args.shift or die("--rules-dir needs a directory")
    found = Dir.glob(File.join(dir, "**", "*.{yar,yara}")).sort
    die("no .yar rules under #{dir}") if found.empty?
    rules_files.concat(found)
  when "--rules"
    file = args.shift or die("--rules needs a file")
    rules_files << file
  when "--diff"
    diff_ref = args.shift or die("--diff needs a git ref")
  when "--pretty" then pretty = true
  when "-h", "--help"
    puts <<~USAGE
      Usage: plugin-audit <plugin-dir> [options]

        --rules-dir DIR   also load every .yar/.yara under DIR (repeatable)
        --rules FILE      also load one rules file (repeatable)
        --diff REF        only report findings on lines added since REF
        --pretty          indent the JSON

      Writes a JSON report to stdout. Exit 0 means the scan ran; read
      .summary.verdict for the outcome.
    USAGE
    exit 0
  else
    die("unexpected argument: #{arg}") if plugin_dir
    plugin_dir = arg
  end
end

die("usage: plugin-audit <plugin-dir>") unless plugin_dir
plugin_dir = File.expand_path(plugin_dir)
die("not a directory: #{plugin_dir}") unless File.directory?(plugin_dir)
rules_files.unshift(DEFAULT_RULES) if File.exist?(DEFAULT_RULES)
die("no rules to run") if rules_files.empty?

yara = ENV["PLUGIN_AUDIT_YARA"] || "yara"
_, status = Open3.capture2e(yara, "--version")
unless status.success?
  die("yara is not installed. Install it with: omarchy pkg add yara")
end

# --- rule metadata -----------------------------------------------------------

# yara -m prints metadata on one line and is awkward to parse per match, so the
# meta blocks are read from the rule sources once. This keeps the .yar file the
# single source of truth for severity and reasoning.
def parse_rule_meta(files)
  meta = {}
  files.each do |file|
    next unless File.file?(file)

    current = nil
    File.foreach(file) do |line|
      if (m = line.match(/^\s*(?:private\s+|global\s+)*rule\s+([A-Za-z0-9_]+)/))
        current = m[1]
        meta[current] = { "severity" => "medium", "category" => "other",
                          "why" => "", "source" => File.basename(file) }
      elsif current && (m = line.match(/^\s*(severity|category|why)\s*=\s*"(.*)"\s*$/))
        meta[current][m[1]] = m[2]
      elsif current && line.match?(/^\s*(strings|condition)\s*:/)
        current = nil
      end
    end
  end
  meta
end

RULE_META = parse_rule_meta(rules_files)

# --- inventory ---------------------------------------------------------------

def relative(path, root)
  path.sub(/\A#{Regexp.escape(root)}\/?/, "")
end

all_files = Dir.glob(File.join(plugin_dir, "**", "*"), File::FNM_DOTMATCH)
             .reject { |p| p.include?("/.git/") || File.directory?(p) }
             .sort

symlinks = all_files.select { |p| File.symlink?(p) }
scannable = all_files.select do |p|
  !File.symlink?(p) && SCANNABLE.include?(File.extname(p).downcase)
end
# extension-less files that are still scripts (bin/foo)
scannable += all_files.select do |p|
  next false if File.symlink?(p) || !File.extname(p).empty?
  next false unless File.file?(p) && File.size(p).positive?

  File.open(p, "rb") { |f| f.read(2) } == "#!"
end
scannable.uniq!

# A file that shipped but was not meaningfully read is part of the verdict,
# not an omission from it. Minified and vendored code is "scanned" only in the
# sense that bytes went past a regex; nobody can review it that way.
MEDIA = %w[.png .jpg .jpeg .gif .webp .svg .mp4 .webm .mov .ico .ttf .otf
           .woff .woff2 .zip .tar .gz .xz].freeze

def minified?(path)
  return false unless %w[.js .css].include?(File.extname(path).downcase)
  return true if File.basename(path).match?(/\.min\.(js|css)\z/)

  longest = 0
  File.foreach(path) { |l| longest = l.length if l.length > longest }
  longest > 500
rescue StandardError
  false
end

low_confidence = scannable.select { |p| minified?(p) || p.include?("/node_modules/") }
                          .map do |p|
  { "file" => relative(p, plugin_dir),
    "reason" => p.include?("/node_modules/") ? "vendored dependency" : "minified" }
end

skipped = all_files.reject { |p| scannable.include?(p) }.map do |p|
  ext = File.extname(p).downcase
  reason =
    if File.symlink?(p) then "symlink, not followed"
    elsif MEDIA.include?(ext) then "media or archive"
    elsif BINARY_SUSPECT.include?(ext) then "compiled binary -- read it by hand"
    else "not an executable text format"
    end
  { "file" => relative(p, plugin_dir), "reason" => reason }
end

executables = all_files.select { |p| !File.symlink?(p) && File.executable?(p) }
binaries = all_files.select { |p| BINARY_SUSPECT.include?(File.extname(p).downcase) }

by_ext = all_files.group_by { |p| File.extname(p).downcase }
                  .transform_values(&:count)
                  .sort_by { |_, v| -v }.to_h

# --- provenance --------------------------------------------------------------

def git(dir, *cmd)
  out, status = Open3.capture2e("git", "-C", dir, *cmd)
  status.success? ? out.strip : nil
end

manifest_path = File.join(plugin_dir, "manifest.json")
manifest = begin
  File.exist?(manifest_path) ? JSON.parse(File.read(manifest_path)) : {}
rescue JSON::ParserError
  {}
end

provenance = {
  "remote" => git(plugin_dir, "remote", "get-url", "origin"),
  "commit" => git(plugin_dir, "rev-parse", "HEAD"),
  "committed_at" => git(plugin_dir, "log", "-1", "--format=%cI"),
  "authors" => git(plugin_dir, "log", "--format=%ae")&.split("\n")&.uniq&.size,
  "dirty" => !git(plugin_dir, "status", "--porcelain").to_s.empty?
}

# --- diff scoping -------------------------------------------------------------

# Reviewing an update, the question is not "is this plugin fine" but "is what
# changed fine". Scanning concatenated diff text would throw away the file
# attribution that comment- and test-demotion depend on, so instead the real
# files are scanned and each finding is checked against the added-line ranges.
def added_line_ranges(dir, ref)
  out, status = Open3.capture2e("git", "-C", dir, "-c", "core.quotePath=false",
                                "diff", "-U0", "#{ref}..HEAD")
  return nil unless status.success?

  ranges = Hash.new { |h, k| h[k] = [] }
  file = nil
  out.each_line do |raw_line|
    line = raw_line.chomp
    if (m = line.match(%r{\A\+\+\+ b/(.+)\z}))
      file = m[1].strip
    elsif file && (m = line.match(/\A@@ -\S+ \+(\d+)(?:,(\d+))? @@/))
      start = m[1].to_i
      count = (m[2] || "1").to_i
      ranges[file] << (start...(start + count)) if count.positive?
    end
  end
  ranges
end

# --- normalisation -----------------------------------------------------------

# Every rule pattern is single-line, so `curl x \` + newline + `| sh` slips
# past all of them -- a one-character evasion. Physical lines are joined into
# logical ones before scanning, and a map carries offsets back to the real line
# numbers so findings still point at the source. Borrowed from the approach in
# ksb.plugin-guard's Scanner.js, which handles this properly.
MAX_JOINED_LINES = 32

def logical_lines(path)
  raw = File.readlines(path)
  out = []
  map = []
  i = 0
  while i < raw.length
    start = i
    line = raw[i].chomp
    joined = 1
    while line.end_with?("\\") && joined < MAX_JOINED_LINES && i + 1 < raw.length
      line = line[0..-2].rstrip + " " + raw[i + 1].chomp.lstrip
      i += 1
      joined += 1
    end
    out << line
    map << start + 1
    i += 1
  end
  [out.join("\n") + "\n", map]
rescue StandardError
  [File.binread(path), nil]
end

# --- scan --------------------------------------------------------------------

diff_ranges = diff_ref ? added_line_ranges(plugin_dir, diff_ref) : nil
die("could not diff against #{diff_ref}") if diff_ref && diff_ranges.nil?
if diff_ranges
  changed = diff_ranges.keys.map { |f| File.join(plugin_dir, f) }
  scannable = scannable.select { |f| changed.include?(f) }
end

findings = []
unless scannable.empty?
  # yara accepts many rules files but exactly one target, so a list of paths
  # goes in via --scan-list rather than as trailing arguments (where files
  # after the first would be parsed as rules).
  require "tempfile"
  require "tmpdir"
  norm_dir = Dir.mktmpdir("plugin-audit-norm")
  norm_to_real = {}
  line_maps = {}
  scannable.each_with_index do |real, idx|
    text, map = logical_lines(real)
    norm = File.join(norm_dir, format("%04d-%s", idx, File.basename(real)))
    File.binwrite(norm, text)
    norm_to_real[norm] = real
    line_maps[norm] = map
  end

  list = Tempfile.new(["plugin-audit-targets", ".txt"])
  begin
    list.write(norm_to_real.keys.join("\n"))
    list.flush

    rules_files.each do |rules_file|
      out, status = Open3.capture2e(yara, "-s", "-w", "--no-follow-symlinks",
                                    "--scan-list", rules_file, list.path)
      # yara exits 0 with matches, 1 on error. Surface a rules error rather
      # than silently reporting a clean plugin.
      unless status.success?
        die("yara failed on #{File.basename(rules_file)}: #{out.lines.first&.strip}")
      end

      current_rule = nil
      current_file = nil
      out.each_line do |line|
        line = line.chomp
        if (m = line.match(/\A([A-Za-z0-9_]+) (.+)\z/)) && File.exist?(m[2])
          current_rule = m[1]
          current_file = m[2]
        elsif current_rule && (m = line.match(/\A0x([0-9a-f]+):(\$[A-Za-z0-9_]+): (.*)\z/))
          offset = m[1].to_i(16)
          meta = RULE_META[current_rule] || {}
          body = File.binread(current_file, offset)
          norm_line = body.count("\n") + 1
          real_file = norm_to_real[current_file] || current_file
          map = line_maps[current_file]
          line_no = map && map[norm_line - 1] ? map[norm_line - 1] : norm_line
          rel = relative(real_file, plugin_dir)
          declared = meta["severity"] || "medium"

          # A pattern inside a comment cannot execute. The most common false
          # positive in practice is an author *documenting* the very thing the
          # rule looks for -- one plugin here is flagged for a comment
          # explaining why it refuses to copy ~/.ssh/id_rsa. Demote rather than
          # drop, so a payload hiding in a string that looks like a comment is
          # still visible.
          source_line = (File.readlines(real_file)[line_no - 1] || "").strip
          in_comment = COMMENT_PREFIXES.any? { |pre| source_line.start_with?(pre) }
          in_test = rel.match?(TEST_PATH)

          severity = declared
          reasons = []

          in_diff = true
          if diff_ranges
            in_diff = (diff_ranges[rel] || []).any? { |r| r.include?(line_no) }
            unless in_diff
              severity = "info"
              reasons << "on a line that predates #{diff_ref[0, 12]}, so it was " \
                         "already there when this plugin was last accepted"
            end
          end

          # Rule-specific refinement: yara finds the candidate, this decides
          # whether it means anything. Cheaper and far more accurate than
          # trying to express "not RFC1918" in a regex with no lookahead.
          if current_rule == "callback_raw_ip_address"
            ip = m[3][%r{(?:\d{1,3}\.){3}\d{1,3}}].to_s
            if ip == METADATA_IP
              reasons << "cloud metadata endpoint -- a classic credential-theft target"
            elsif ip.match?(PRIVATE_IP)
              declared = "info"
              severity = "info"
              reasons << "private or loopback address, so this is the user's own network"
            elsif BENIGN_IP.include?(ip)
              declared = "info"
              severity = "info"
              reasons << "well-known public resolver, so this is a connectivity check"
            elsif ip.match?(DOC_IP)
              declared = "info"
              severity = "info"
              reasons << "reserved documentation or multicast address, not a real destination"
            end
          end

          if in_comment
            severity = "info"
            reasons << "match is inside a comment, so it cannot execute"
          elsif in_test
            severity = DEMOTE.fetch(declared, declared)
            reasons << "match is in test code, which the shell never loads"
          end

          findings << {
            "rule" => current_rule,
            "severity" => severity,
            "declared_severity" => declared,
            "demoted_because" => reasons.first,
            "category" => meta["category"] || "other",
            "why" => meta["why"] || "",
            "file" => rel,
            "line" => line_no,
            "match" => m[3][0, 160],
            "source" => meta["source"],
            "in_diff" => in_diff
          }
        end
      end
    end
  ensure
    list.close
    list.unlink
    FileUtils.remove_entry(norm_dir) if norm_dir && File.directory?(norm_dir)
  end
end

# --- structural checks -------------------------------------------------------

# Cross-file and manifest-relative signals. You can hide a string, but not the
# structural fact that code loads QML the manifest never declared, or that a
# script decodes a shipped data file and executes the result. These are what
# the sophisticated red-team sample relied on -- assembled at runtime so no
# malicious literal exists -- and they are deterministic to catch here.
DECODE_PRIM = /reverse\s*\(|\[::-1\]|\batob\b|fromCharCode|base64|b64decode|\.fromhex\(|codecs\.decode|rot13|unpack/
EXEC_PRIM   = /subprocess\.|os\.system|\bexec\b|\beval\b|Popen|execDetached|Qt\.createQmlObject|Qt\.createComponent|-c[ \t]/
QML_LOAD    = /Qt\.createQmlObject|Qt\.createComponent/

net_primitive_files = {}

scannable.each do |file|
  body = File.read(file) rescue next
  rel = relative(file, plugin_dir)

  # An outbound send of any kind, literal URL or not -- used by the exfil combo
  # so a runtime-assembled destination does not hide the send.
  if body.match?(/\bcurl\b|\bwget\b|-X[ \t]+POST|--data|XMLHttpRequest|\bfetch\s*\(|\/dev\/tcp\/|\bnc\b[ \t]|socat|new[ \t]+WebSocket|http\.(request|post)|requests\.(post|get)|urllib|Net::HTTP/)
    (net_primitive_files ||= {})[rel] = true
  end

  # A: QML built and loaded at runtime FROM a decoded/reversed source. A literal
  #    createQmlObject("import ...") is normal; the finding is the decode
  #    primitive sitting next to the load, not merely both appearing in the file.
  qml_lines = body.lines
  qml_at = qml_lines.index { |l| l.match?(QML_LOAD) }
  qml_dec_near = qml_at && (([qml_at - 3, 0].max)..(qml_at + 3)).any? do |i|
    i < qml_lines.length && qml_lines[i].match?(DECODE_PRIM)
  end
  if qml_at && qml_dec_near
    findings << {
      "rule" => "structure_runtime_qml_load", "severity" => "high",
      "declared_severity" => "high", "demoted_because" => nil,
      "category" => "obfuscation",
      "why" => "Builds and loads QML at runtime from a decoded or reversed " \
               "source (a decode primitive sits next to the createQmlObject/" \
               "createComponent call), which hides what code is actually run.",
      "file" => rel, "line" => qml_at + 1,
      "match" => "Qt.createQmlObject with a decoded source",
      "source" => "structural", "in_diff" => true
    }
  end

  # B: a script that reads a shipped non-code file, decodes it, and executes
  #    the result. The payload lives in the data file; the script is only the
  #    loader, so nothing overtly bad is in the code itself.
  referenced_data = all_files.select do |f|
    ext = File.extname(f).downcase
    (OPAQUE_DATA.include?(ext) || ext.empty?) &&
      !MEDIA.include?(ext) && !executables.include?(f) &&
      body.include?(File.basename(f))
  end
  lines = body.lines
  dec_at = lines.index { |l| l.match?(DECODE_PRIM) }
  exec_at = lines.index { |l| l.match?(EXEC_PRIM) }
  close = dec_at && exec_at && (dec_at - exec_at).abs <= 12
  if referenced_data.any? && close
    line = (exec_at || 0) + 1
    findings << {
      "rule" => "structure_data_payload_exec", "severity" => "high",
      "declared_severity" => "high", "demoted_because" => nil,
      "category" => "obfuscation",
      "why" => "Reads a shipped data file (#{referenced_data.map { |f| relative(f, plugin_dir) }.join(", ")[0, 80]}), " \
               "decodes it, and executes the result. The payload lives in the " \
               "data file, so the code carries nothing overtly malicious.",
      "file" => rel, "line" => line, "match" => "decode + exec of a shipped data file",
      "source" => "structural", "in_diff" => true
    }
  end
end

# --- shellcheck ---------------------------------------------------------------

# A different question from the rules above: not "is this malicious" but "can
# this be made to misbehave". shellcheck is a real shell parser, so it sees
# seams the patterns structurally cannot. Only the codes that describe an
# injection seam -- style noise would bury everything else.
INJECTION_CODES = {
  2086 => "unquoted expansion -- word splitting and globbing reach the command",
  2046 => "unquoted command substitution -- its output is split into arguments",
  2068 => "unquoted array expansion -- elements are re-split",
  2048 => "unquoted $* -- arguments are re-split",
  2294 => "eval on a variable -- whatever lands in it is executed"
}.freeze
# Untrusted input on this machine: notifications, clipboard, filenames,
# compositor JSON, network responses. An unquoted expansion in a file that
# never touches any of these is a robustness bug; one that does is a seam.
EXTERNAL_INPUT = /notify-send|wl-paste|xclip|hyprctl[^\n]{0,40}-j|\bcurl\b|\bwget\b|jq[ \t]+-r|\$\(cat[ \t]/.freeze

shell_files = scannable.select do |f|
  %w[.sh .bash].include?(File.extname(f).downcase) ||
    (File.extname(f).empty? && File.open(f, "rb") { |h| h.read(11).to_s } =~ /\A#!.*sh/)
end

shellcheck_ran = false
unless shell_files.empty?
  sc_out, sc_status = Open3.capture2e("shellcheck", "-f", "json",
                                      "-i", INJECTION_CODES.keys.join(","),
                                      *shell_files)
  # shellcheck exits 1 when it has findings, which is the normal case.
  if sc_status.exitstatus && sc_status.exitstatus < 2 || !sc_out.empty?
    begin
      shellcheck_ran = true
      JSON.parse(sc_out).each do |issue|
        code = issue["code"].to_i
        detail = INJECTION_CODES[code] or next
        file = issue["file"]
        exploitable = File.read(file).match?(EXTERNAL_INPUT) rescue false
        severity =
          if code == 2294 then "high"
          elsif exploitable then "medium"
          else "low"
          end
        findings << {
          "rule" => "injection_SC#{code}",
          "severity" => severity,
          "declared_severity" => severity,
          "demoted_because" => nil,
          "category" => "injection",
          "why" => detail + (exploitable && code != 2294 ?
            ". This file also reads notification, clipboard, filename or " \
            "network data, so an attacker may control what lands here." : "."),
          "file" => relative(file, plugin_dir),
          "line" => issue["line"].to_i,
          "match" => issue["message"].to_s[0, 160],
          "source" => "shellcheck"
        }
      end
    rescue JSON::ParserError
      shellcheck_ran = false
    end
  end
end

# One row per rule+file: a rule that hits forty times in one file is one thing
# to look at, not forty. The count is kept so volume is still visible.
grouped = findings.group_by { |f| [f["rule"], f["file"]] }.map do |(rule, file), hits|
  # Group on the worst hit: one runnable match matters more than ten in
  # comments, so a file with both is reported at the runnable severity.
  worst = hits.max_by { |h| SEVERITY_ORDER.fetch(h["severity"], 1) }
  {
    "rule" => rule,
    "short" => short_label(rule),
    "severity" => worst["severity"],
    "declared_severity" => worst["declared_severity"],
    "demoted_because" => worst["demoted_because"],
    "category" => worst["category"],
    "why" => worst["why"],
    "file" => file,
    "hits" => hits.size,
    "lines" => hits.map { |h| h["line"] }.uniq.sort.first(12),
    "samples" => hits.map { |h| h["match"] }.uniq.first(4)
  }
end

# Exfil combo: a file that both reaches a real secret and talks to the network
# is the supply-chain shape -- read the credential, send it out. The recent
# ecosystem attacks all had this form, often shipping to a legitimate-looking
# host (a GitHub gist, an npm registry), so this deliberately does not care
# where the traffic goes. Built from co-located findings, in plugin-guard's
# combo style.
by_file = grouped.group_by { |f| f["file"] }
by_file.each do |file, fs|
  cred = fs.find do |f|
    f["category"] == "credential" &&
      SEVERITY_ORDER.fetch(f["severity"], 0) >= SEVERITY_ORDER["medium"]
  end
  net_finding = fs.find { |f| f["category"] == "callback" && f["rule"] != "capability_opens_browser" }
  has_net = net_finding || net_primitive_files[file]
  next unless cred && has_net
  net_desc = net_finding ? net_finding["rule"] : "an outbound send (curl/POST/socket)"

  grouped << {
    "rule" => "combo_credential_exfil",
    "short" => "Reads a secret and sends it out",
    "severity" => "high",
    "declared_severity" => "high",
    "demoted_because" => nil,
    "category" => "combo",
    "why" => "This file reads a credential (#{cred["rule"]}) AND sends data to " \
             "the network (#{net_desc}). That combination is exfiltration " \
             "regardless of the destination -- recent supply-chain attacks " \
             "shipped stolen keys to ordinary hosts like github.com. Confirm " \
             "what leaves this machine and where it goes.",
    "file" => file,
    "hits" => 2,
    "lines" => (cred["lines"] + (net_finding ? net_finding["lines"] : [])).uniq.sort.first(12),
    "samples" => ["credential: #{cred["rule"]}", "network: #{net_desc}"]
  }
end

grouped.sort_by! { |f| [-SEVERITY_ORDER.fetch(f["severity"], 1), f["file"], f["rule"]] }

counts = Hash.new(0)
grouped.each { |f| counts[f["severity"]] += 1 }

# `info` rules describe reach, not risk, so they never move the verdict.
verdict =
  if counts["high"].positive? then "review-required"
  elsif counts["medium"].positive? then "review-suggested"
  else "no-static-findings"
  end

# What this scan structurally cannot see. Shipped with every report, so a
# passing verdict is never read as "this plugin is safe" -- it means "no rule
# matched this source at this commit".
limitations = [
  { "id" => "source-only",
    "detail" => "Pattern matching over source. Anything assembled at runtime " \
                "-- a URL built from fragments, a command decoded before " \
                "execution -- is invisible to it." },
  { "id" => "point-in-time",
    "detail" => "Describes commit #{provenance["commit"].to_s[0, 12]} only. " \
                "The plugin can fetch and run different code after install, " \
                "and an update ships code this report never saw." },
  { "id" => "no-behaviour",
    "detail" => "Nothing was executed and no traffic was observed. Logic " \
                "gated on a date, a hostname or a random draw looks inert here." },
  { "id" => "intent-not-judged",
    "detail" => "Rules match capability, not purpose. Whether reading a " \
                "credential is this plugin's job is a question about the " \
                "plugin's stated purpose, which only a reader can answer." }
]
if low_confidence.any?
  limitations << { "id" => "unreviewable-code",
                   "detail" => "#{low_confidence.size} minified or vendored " \
                               "file(s) were pattern-matched but cannot be " \
                               "meaningfully reviewed this way." }
end
unless shellcheck_ran
  limitations << { "id" => "no-shell-analysis",
                   "detail" => "shellcheck did not run, so command-injection " \
                               "seams in shell scripts were not examined. " \
                               "Install it with: omarchy pkg add shellcheck" }
end
if binaries.any?
  limitations << { "id" => "shipped-binaries",
                   "detail" => "#{binaries.size} compiled file(s) shipped and " \
                               "were not analysed at all." }
end

caveat =
  case verdict
  when "no-static-findings"
    "No rule matched this source at this commit. That is not the same as safe " \
    "-- see limitations."
  when "review-suggested"
    "Findings worth a look, none of them conclusive on their own."
  else
    "At least one finding needs a person to decide whether the plugin's " \
    "purpose justifies it."
  end

report = {
  "schema" => 1,
  "plugin" => {
    "id" => manifest["id"],
    "name" => manifest["name"],
    "version" => manifest["version"],
    "author" => manifest["author"],
    "path" => plugin_dir,
    "kinds" => manifest["kinds"],
    "keepLoaded" => manifest["keepLoaded"]
  },
  "provenance" => provenance,
  "inventory" => {
    "files" => all_files.size,
    "scanned" => scannable.size,
    "by_extension" => by_ext,
    "symlinks" => symlinks.map { |p| relative(p, plugin_dir) },
    "executables" => executables.map { |p| relative(p, plugin_dir) },
    "suspect_binaries" => binaries.map { |p| relative(p, plugin_dir) }
  },
  "coverage" => {
    "scanned" => scannable.size,
    "skipped" => skipped.first(200),
    "skipped_total" => skipped.size,
    "low_confidence" => low_confidence.first(50),
    "low_confidence_total" => low_confidence.size
  },
  "limitations" => limitations,
  "rules" => rules_files.map { |f| relative(File.expand_path(f), SOURCE_ROOT) },
  "scope" => diff_ref ? { "mode" => "diff", "since" => diff_ref,
                          "changed_files" => (diff_ranges&.keys || []) }
                      : { "mode" => "full-tree" },
  "findings" => grouped,
  "summary" => {
    "verdict" => verdict,
    "caveat" => caveat,
    "high" => counts["high"],
    "medium" => counts["medium"],
    "low" => counts["low"],
    "info" => counts["info"]
  }
}

puts(pretty ? JSON.pretty_generate(report) : JSON.generate(report))
