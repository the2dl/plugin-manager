#!/bin/bash

set -euo pipefail

export GIT_TERMINAL_PROMPT=0
export LC_ALL=C

SCRIPT_PATH="$(realpath -m -- "${BASH_SOURCE[0]}")"
readonly SCRIPT_PATH
BACKEND_ROOT="$(realpath -m -- "$(dirname -- "$SCRIPT_PATH")/../lib/backend")"
readonly BACKEND_ROOT

for backend_module in common config catalog updates snapshot actions lifecycle; do
  # Workers use the same modules from their staged private directory.
  # shellcheck disable=SC1090
  source "$BACKEND_ROOT/$backend_module.sh"
done
unset backend_module

usage() {
  json_error "usage: plugin-control <cached|refresh|check-updates|audit|audit-remote|audit-update|audit-updates|update-all|preview|ensure-config|config-status|status|action|ack|benchmark> ..."
}

# audit_command <public-root> <plugin-dir> [diff-ref]
# Runs bin/plugin-audit and passes its JSON straight through. Degrades to a
# structured JSON error the UI can render, rather than failing the process,
# when yara is missing or the target is not a plugin.
audit_command() {
  local root="$1" dir="$2" diff="${3:-}"
  local auditor="$root/bin/plugin-audit"
  if [[ ! -x $auditor ]]; then
    json_error "security scanner not found in this Plugin Control checkout"
    return 0
  fi
  if ! command -v yara >/dev/null 2>&1; then
    printf '%s\n' '{"schema":1,"summary":{"verdict":"scan-unavailable","caveat":"yara is not installed, so no static scan ran. Install it with: omarchy pkg add yara"},"findings":[],"limitations":[{"id":"no-scanner","detail":"yara is not installed"}]}'
    return 0
  fi
  if [[ ! -d $dir ]]; then
    json_error "plugin directory not found: $dir"
    return 0
  fi
  local args=("$dir")
  [[ -n $diff ]] && args+=(--diff "$diff")
  # plugin-audit exits 0 on a completed scan regardless of findings; a non-zero
  # exit is a real failure, which we surface as JSON rather than raw stderr.
  if ! "$auditor" "${args[@]}" 2>/dev/null; then
    json_error "security scan failed"
  fi
}

# audit_remote_command <public-root> <repo-url> [commit]
# Shallow-clones an untrusted repo to a temp dir with hooks and symlinks
# disabled, scans it, and removes it. The clone is never executed and never
# installed -- it exists only to be read by plugin-audit.
audit_remote_command() {
  local root="$1" repo="$2" commit="${3:-}"
  if ! command -v yara >/dev/null 2>&1; then
    printf '%s\n' '{"schema":1,"summary":{"verdict":"scan-unavailable","caveat":"yara is not installed, so no static scan ran. Install it with: omarchy pkg add yara"},"findings":[],"limitations":[{"id":"no-scanner","detail":"yara is not installed"}]}'
    return 0
  fi
  # Reuse Omarchy's own URL guard so a hostile URL cannot run a git transport
  # helper before we ever clone it.
  if command -v omarchy-git-url-check >/dev/null 2>&1; then
    omarchy-git-url-check "$repo" >/dev/null 2>&1 || { json_error "refused suspicious repository URL"; return 0; }
  fi
  local tmp
  tmp="$(mktemp -d "${TMPDIR:-/tmp}/plugin-control-scan.XXXXXX")" || { json_error "could not create scan workspace"; return 0; }
  # Best-effort cleanup even on failure. The trap disarms itself first: bash
  # does not scope a RETURN trap to the function that set it, so one left armed
  # fires again on the next function return, where $tmp is out of scope and
  # `set -u` turns that into an error escaping a scan that actually succeeded.
  trap 'trap - RETURN; [[ -z ${tmp:-} ]] || rm -rf -- "$tmp"' RETURN
  if ! GIT_TERMINAL_PROMPT=0 GIT_ASKPASS=true git \
      -c core.hooksPath=/dev/null -c core.symlinks=false \
      -c protocol.ext.allow=never \
      clone --quiet --depth 1 --single-branch --no-tags -- "$repo" "$tmp/src" 2>/dev/null; then
    json_error "could not clone $repo for scanning"
    return 0
  fi
  # A commit ref from the catalog is only ever used if it is a plain hex SHA --
  # so it can never be parsed as a git option (e.g. --upload-pack=<cmd>).
  if [[ -n $commit && $commit =~ ^[0-9a-fA-F]{7,64}$ ]]; then
    git -C "$tmp/src" -c protocol.ext.allow=never -c core.hooksPath=/dev/null \
      fetch --quiet --depth 1 origin "$commit" 2>/dev/null \
      && git -C "$tmp/src" -c core.hooksPath=/dev/null \
        checkout --quiet --detach "$commit" 2>/dev/null || true
  fi
  audit_command "$root" "$tmp/src" ""
}

# audit_update_command <public-root> <plugin-dir>
# Fetches the plugin's upstream, checks the incoming tip out to a temporary
# worktree, and scans the diff from the installed commit to that tip. The
# incoming code is only ever read, never merged into the live checkout.
audit_update_command() {
  local root="$1" dir="$2"
  if ! command -v yara >/dev/null 2>&1; then
    printf '%s\n' '{"schema":1,"summary":{"verdict":"scan-unavailable","caveat":"yara is not installed, so no static scan ran. Install it with: omarchy pkg add yara"},"findings":[],"limitations":[{"id":"no-scanner","detail":"yara is not installed"}]}'
    return 0
  fi
  [[ -d $dir/.git ]] || { audit_command "$root" "$dir" ""; return 0; }
  local here upstream tmp
  here="$(git -C "$dir" rev-parse HEAD 2>/dev/null)" || { audit_command "$root" "$dir" ""; return 0; }
  # Fetch enough history to diff against the installed commit.
  git -C "$dir" fetch --quiet --depth 50 origin 2>/dev/null || true
  upstream="$(git -C "$dir" rev-parse --verify --quiet '@{u}' 2>/dev/null)" \
    || upstream="$(git -C "$dir" rev-parse --verify --quiet origin/HEAD 2>/dev/null)" \
    || upstream="$(git -C "$dir" rev-parse --verify --quiet origin/main 2>/dev/null)" \
    || upstream="$(git -C "$dir" rev-parse --verify --quiet origin/master 2>/dev/null)"
  if [[ -z $upstream || $upstream == "$here" ]]; then
    # nothing incoming (or no upstream) -- fall back to scanning what is here.
    audit_command "$root" "$dir" ""
    return 0
  fi
  tmp="$(mktemp -d "${TMPDIR:-/tmp}/plugin-control-update.XXXXXX")" || { audit_command "$root" "$dir" ""; return 0; }
  # Self-disarming for the same reason as the scan trap above.
  trap 'trap - RETURN; [[ -z ${tmp:-} ]] || { git -C "$dir" worktree remove --force "$tmp/tree" 2>/dev/null; rm -rf -- "$tmp"; }' RETURN
  if ! git -C "$dir" worktree add --quiet --detach "$tmp/tree" "$upstream" 2>/dev/null; then
    audit_command "$root" "$dir" ""
    return 0
  fi
  # Diff from the installed commit if it is reachable in the incoming history;
  # otherwise scan the whole incoming tree.
  if git -C "$tmp/tree" merge-base --is-ancestor "$here" HEAD 2>/dev/null; then
    audit_command "$root" "$tmp/tree" "$here"
  else
    audit_command "$root" "$tmp/tree" ""
  fi
}

# audit_updates_command <public-root>
# For every plugin with a pending update, scan the incoming diff and collect a
# compact row: id, name, verdict, high/medium counts, and short finding labels.
audit_updates_command() {
  local root="$1"
  init_paths
  local us="$UPDATE_STATE"
  local ids=""
  [[ -f $us && ! -L $us ]] && ids="$(jq -r '.records[]?|select(.updateAvailable==true)|.id' "$us" 2>/dev/null)"
  local rows="[]"
  local id dir report row
  while IFS= read -r id; do
    [[ -n $id ]] || continue
    [[ $id == */* || $id == .* || $id == *..* ]] && continue
    dir="$PLUGINS_ROOT/$id"
    [[ -d $dir ]] || continue
    report="$(audit_update_command "$root" "$dir" 2>/dev/null)"
    row="$(jq -c --arg id "$id" '{
      id: $id,
      name: (.plugin.name // $id),
      verdict: .summary.verdict,
      high: (.summary.high // 0),
      medium: (.summary.medium // 0),
      findings: [ .findings[]? | select(.severity != "info") | .short ] | unique
    }' <<<"$report" 2>/dev/null)" || continue
    [[ -n $row ]] && rows="$(jq -c --argjson row "$row" '. + [$row]' <<<"$rows")"
  done <<<"$ids"
  jq -cn --argjson rows "$rows" '{
    plugins: $rows,
    counts: {
      total: ($rows | length),
      clean: ($rows | map(select(.verdict == "no-static-findings")) | length),
      flagged: ($rows | map(select(.verdict == "review-required" or .verdict == "review-suggested")) | length)
    }
  }'
}

# update_all_command <public-root> <id...>
# Update each id in turn. Because this drives `omarchy plugin update` directly
# rather than plugin-control's own action, it must clear plugin-control's
# update state for the plugins it updated -- otherwise they keep showing a
# pending update. Then rebuild the snapshot so the shell sees them as current.
update_all_command() {
  local root="$1"; shift
  init_paths
  local results="[]" id
  local ok_ids=()

  # omarchy-plugin-update runs `omarchy-shell shell rescanPlugins` after EVERY
  # successful update. This helper is a child process of that shell, so the
  # first success hot-reloads the plugin, destroys the QML Process running this
  # script, and the loop dies after one plugin -- no summary, and the state
  # rewrite below never happens. Neutralise the per-update rescan with a no-op
  # on PATH; there is a single real rescan at the end of this function.
  local shim; shim="$(mktemp -d)"
  printf '#!/bin/sh\nexit 0\n' >"$shim/omarchy-shell"
  chmod +x "$shim/omarchy-shell"

  for id in "$@"; do
    if PATH="$shim:$PATH" omarchy plugin update "$id" --yes >/dev/null 2>&1; then
      results="$(jq -c --arg id "$id" '. + [{id:$id, ok:true}]' <<<"$results")"
      ok_ids+=("$id")
    else
      results="$(jq -c --arg id "$id" '. + [{id:$id, ok:false}]' <<<"$results")"
    fi
  done

  rm -rf "$shim"

  if (( ${#ok_ids[@]} )) && [[ -f $UPDATE_STATE && ! -L $UPDATE_STATE ]]; then
    local ids_json tmp
    ids_json="$(printf '%s\n' "${ok_ids[@]}" | jq -R . | jq -cs .)"
    # Serialise against a concurrent check-updates writer.
    exec 9>>"$UPDATE_STATE_LOCK"
    flock 9
    tmp="$(mktemp "${UPDATE_STATE}.XXXXXX")"
    if jq --argjson ids "$ids_json" --arg now "$(utc_now)" '
        .records = ((.records // []) | map(
          if (.id as $i | $ids | index($i)) then
            .status = "current" | .updateAvailable = false | .reason = ""
            | .localCommit = (.remoteCommit // .localCommit)
            | .checkedAt = $now
          else . end))
      ' "$UPDATE_STATE" > "$tmp" 2>/dev/null; then
      mv -f "$tmp" "$UPDATE_STATE"
    else
      rm -f "$tmp"
    fi
    flock -u 9 2>/dev/null || true
    exec 9>&- 2>/dev/null || true
  fi

  build_snapshot "$root" >/dev/null 2>&1 || true
  omarchy-shell -q shell rescanPlugins >/dev/null 2>&1 || true
  jq -cn --argjson r "$results" '{
    results: $r,
    ok: ($r | map(select(.ok)) | length),
    failed: ($r | map(select(.ok | not)) | length)
  }'
}

main() {
  local command="${1:-}"
  shift || true
  case "$command" in
    start)
      require_cli_tool jq
      require_cli_tool omarchy
      require_cli_tool omarchy-shell
      require_cli_tool ruby
      init_paths
      local public_root
      public_root="$(source_root "$(dirname -- "$SCRIPT_PATH")/..")" ||
        cli_fail "could not find the installed Plugin Control checkout"
      start_command "$public_root" "$@"
      return
      ;;
    stop)
      require_cli_tool omarchy
      stop_command "$@"
      return
      ;;
    help|-h|--help)
      (( $# == 0 )) || {
        public_usage >&2
        return 2
      }
      public_usage
      return
      ;;
    "")
      public_usage >&2
      return 2
      ;;
  esac

  require_tool curl
  require_tool flock
  require_tool git
  require_tool jq
  require_tool omarchy
  require_tool realpath
  require_tool ruby
  require_tool setsid
  require_tool sha256sum
  require_tool timeout
  init_paths

  case "$command" in
    cached)
      (( $# == 1 )) || { usage; return 2; }
      cached_command "$(source_root "$1")"
      ;;
    refresh)
      (( $# >= 1 && $# <= 2 )) || { usage; return 2; }
      local root
      root="$(source_root "$1")"
      shift
      refresh_command "$root" "${1:-}"
      ;;
    check-updates)
      (( $# == 1 )) || { usage; return 2; }
      check_updates_command "$(source_root "$1")"
      ;;
    audit)
      # Read-only static security scan of a plugin directory. Additive: never
      # touches add/enable/remove. Emits the plugin-audit JSON (or a JSON error
      # if the scanner or yara is unavailable) so the UI can gate on it.
      (( $# >= 2 && $# <= 3 )) || { usage; return 2; }
      audit_command "$(source_root "$1")" "$2" "${3:-}"
      ;;
    audit-remote)
      # Pre-flight scan of a plugin that is not installed yet: clone it shallow
      # to a throwaway dir, scan, discard. Nothing is enabled or kept. Lets the
      # UI show findings before the real `omarchy plugin add` runs.
      (( $# >= 2 && $# <= 3 )) || { usage; return 2; }
      audit_remote_command "$(source_root "$1")" "$2" "${3:-}"
      ;;
    audit-update)
      # Scan the code an update WOULD bring: fetch upstream, check it out to a
      # throwaway worktree (never applied), and diff against the installed
      # commit. Read-only -- the incoming code is scanned, not run or installed.
      (( $# == 2 )) || { usage; return 2; }
      audit_update_command "$(source_root "$1")" "$2"
      ;;
    audit-updates)
      # Batch: scan the incoming diff of every plugin with a pending update.
      # Read-only. Returns one JSON row per plugin with its verdict.
      (( $# == 1 )) || { usage; return 2; }
      audit_updates_command "$(source_root "$1")"
      ;;
    update-all)
      # Update the given plugin ids in sequence (the UI passes the set it
      # chose after seeing the scan). Returns per-id results.
      (( $# >= 2 )) || { usage; return 2; }
      local root; root="$(source_root "$1")"; shift
      update_all_command "$root" "$@"
      ;;
    preview)
      (( $# == 4 )) || { usage; return 2; }
      require_tool magick
      preview_command "$1" "$2" "$3" "$4"
      ;;
    ensure-config)
      (( $# == 1 )) || { usage; return 2; }
      local root
      root="$(source_root "$1")"
      ensure_config "$root"
      config_status "$root"
      ;;
    config-status)
      (( $# == 1 )) || { usage; return 2; }
      config_status "$(source_root "$1")"
      ;;
    status)
      (( $# == 0 )) || { usage; return 2; }
      status_command
      ;;
    action)
      (( $# == 5 )) || { usage; return 2; }
      action_command "$(source_root "$1")" "$2" "$3" "$4" "$5"
      ;;
    ack)
      (( $# == 1 )) || { usage; return 2; }
      ack_command "$1"
      ;;
    benchmark)
      (( $# == 1 )) || { usage; return 2; }
      benchmark_command "$(source_root "$1")"
      ;;
    _worker)
      (( $# == 6 )) || return 2
      worker_command "$@"
      ;;
    *)
      usage
      return 2
      ;;
  esac
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  main "$@"
fi
